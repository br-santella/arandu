# Copy to .env and fill in. Never commit .env.
# Prototype goal: zero fixed cost. Every default below is free.

# ---------------------------------------------------------------------------
# App (PUBLIC: EXPO_PUBLIC_* values are bundled into the app. No secrets here.)
# ---------------------------------------------------------------------------
# Local: PUBLISHABLE_KEY printed by `supabase start`. Remote: project settings > API Keys.
# Publishable keys (sb_publishable_...) are public by design; RLS protects the data.
# Remote values live in .env.remote (gitignored); never put secret keys in EXPO_PUBLIC_*.
# Expo reads .env from apps/mobile/: copy the EXPO_PUBLIC_* lines to apps/mobile/.env.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# MapLibre style URL. Free options: OpenFreeMap (no key) or a PMTiles style
# hosted in Supabase Storage. Swapping providers must not require code changes.
EXPO_PUBLIC_MAP_STYLE_URL=

# ---------------------------------------------------------------------------
# Server only (pipeline and admin). NEVER expose to the app.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection for scripts (e.g. IBGE import). Local default below;
# for the remote project, use its connection string (never commit it).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---------------------------------------------------------------------------
# LLM: any OpenAI-compatible endpoint. Default: local Ollama (free).
# For the guide Edge Function, set these with `supabase secrets set`.
# From a local Supabase Edge Function, reach the host Ollama via
# http://host.docker.internal:11434/v1
# ---------------------------------------------------------------------------
LLM_BASE_URL=http://localhost:11434/v1
# Pin the exact Ollama tag and record it (with the Ollama ID) in docs/decisoes.md.
LLM_MODEL=qwen3.5:9b
# Empty for Ollama. Only for hosted providers, and only after setting a spend cap.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
# Disable "thinking" on reasoning models: ~25x faster for extraction (docs/decisoes.md).
LLM_REASONING_EFFORT=none

# ---------------------------------------------------------------------------
# Embeddings: must be the SAME model for indexing and querying.
# qwen3-embedding:0.6b outputs 1024 dims, matching content_chunk.embedding vector(1024).
# Fallback: bge-m3 (also 1024 dims, no query instruction). Changing model = reindex all chunks.
# ---------------------------------------------------------------------------
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=
# Applied to queries only, never to documents. Must match the guide Edge Function.
EMBEDDING_QUERY_INSTRUCTION=Given a question about places with Indigenous or Afro-Brazilian history, retrieve passages that answer it

# ---------------------------------------------------------------------------
# Guide limits (cost and abuse control)
# ---------------------------------------------------------------------------
GUIDE_RATE_LIMIT_PER_HOUR=20
GUIDE_MAX_OUTPUT_TOKENS=400
GUIDE_TOP_K=5

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
TESSERACT_LANG=por
# Nominatim usage policy: max 1 request/second and an identifying User-Agent.
# Use a generic project name; do not put personal emails here.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=arandu-prototype
NOMINATIM_MIN_INTERVAL_SECONDS=1.0
GEOCODE_MIN_CONFIDENCE=0.6
