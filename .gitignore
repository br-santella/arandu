# Secrets
.env
.env.*
!.env.example

# Node / Expo
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo
npm-debug.log*

# Native builds (generated by expo prebuild / run)
apps/mobile/android/
apps/mobile/ios/
*.apk
*.aab
*.keystore
*.jks

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Pipeline data: documents and caches stay local (large; licenses tracked in `source`)
pipeline/data/raw/*
pipeline/data/processed/*
!pipeline/data/raw/.gitkeep
!pipeline/data/processed/.gitkeep

# Supabase local state
supabase/.branches/
supabase/.temp/

# Map tiles (large; hosted in Storage)
*.pmtiles

# OS / editors
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
